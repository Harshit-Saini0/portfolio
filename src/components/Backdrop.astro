---
// Fixed, behind everything: a scroll-driven colour wash plus a field of dots
// driven by drifting fractal noise. The noise reads like terrain — dots only
// appear above a "sea level" threshold, and grow towards the centre of each
// landmass, so clusters have fat cores and fray into fine grain at the edges.
// Purely decorative; it turns itself off for visitors who prefer reduced motion.
---

<div class="backdrop" aria-hidden="true">
  <div class="backdrop-tint"></div>
  <canvas class="backdrop-dots"></canvas>
</div>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ── Scroll progress → CSS var, drives the colour wash ──────────────
  const root = document.documentElement;
  let ticking = false;

  const setProgress = () => {
    const max = root.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    root.style.setProperty('--scroll', p.toFixed(4));
    ticking = false;
  };

  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(setProgress);
      }
    },
    { passive: true }
  );
  addEventListener('resize', setProgress, { passive: true });
  setProgress();

  // ── Dot terrain ───────────────────────────────────────────────────
  const canvas = document.querySelector<HTMLCanvasElement>('.backdrop-dots');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx && !reduced.matches) {
    // Tunables.
    const SPACING = 20; // px between dot slots
    const MAX_R = 3.2; // radius of a dot at the centre of a cluster
    const SEA = 0.52; // noise below this = empty space
    const PEAK = 0.78; // noise at or above this = full-size dot
    const ALPHA = 0.3; // overall opacity ceiling
    const DRIFT = 0.00022; // ambient morph speed, independent of scroll
    const SCROLL_RATE = 0.0022; // noise units travelled per pixel scrolled
    const EASE = 0.08; // how quickly the field catches up to the scroll
    const FPS = 30;

    // ── Value noise ────────────────────────────────────────────────
    // Hash → [0,1), stable for a given lattice point and layer.
    const hash = (x: number, y: number, z: number) => {
      let h = x * 374761393 + y * 668265263 + z * 1442695040;
      h = (h ^ (h >>> 13)) * 1274126177;
      return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
    };

    const smooth = (t: number) => t * t * (3 - 2 * t);

    const noise2 = (x: number, y: number, z: number) => {
      const xi = Math.floor(x);
      const yi = Math.floor(y);
      const xf = smooth(x - xi);
      const yf = smooth(y - yi);

      const a = hash(xi, yi, z);
      const b = hash(xi + 1, yi, z);
      const c = hash(xi, yi + 1, z);
      const d = hash(xi + 1, yi + 1, z);

      return (a + (b - a) * xf) * (1 - yf) + (c + (d - c) * xf) * yf;
    };

    // Three octaves: broad landmasses, then coastline detail.
    const terrain = (x: number, y: number, t: number) =>
      noise2(x, y, 1) * 0.55 +
      noise2(x * 2.1 + t, y * 2.1 - t, 2) * 0.3 +
      noise2(x * 4.3 - t * 1.7, y * 4.3 + t * 1.7, 3) * 0.15;

    // ── Canvas sizing ──────────────────────────────────────────────
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0;
    let h = 0;
    let cols = 0;
    let rows = 0;
    let jitter: Float32Array = new Float32Array(0);

    const resize = () => {
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      cols = Math.ceil(w / SPACING) + 1;
      rows = Math.ceil(h / SPACING) + 1;

      // Fixed per-slot offset so the grid never reads as a grid, but dots
      // also never jitter between frames.
      jitter = new Float32Array(cols * rows * 2);
      for (let i = 0; i < cols * rows; i++) {
        jitter[i * 2] = (hash(i, 7, 11) - 0.5) * SPACING * 0.85;
        jitter[i * 2 + 1] = (hash(i, 13, 17) - 0.5) * SPACING * 0.85;
      }
    };
    resize();
    addEventListener('resize', resize, { passive: true });

    // Dot colour comes from CSS so both themes stay in one place.
    let ink = '#6b2231';
    const readInk = () => {
      ink = getComputedStyle(document.body).getPropertyValue('--dot').trim() || ink;
    };
    readInk();
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', readInk);

    let paused = false;
    let lastDraw = 0;
    const frameGap = 1000 / FPS;

    // The field travels with the scroll position; `eased` chases the target so
    // the terrain keeps flowing for a moment after you stop, instead of
    // snapping. Ambient drift on top means it is never completely still.
    let eased = window.scrollY * SCROLL_RATE;

    const draw = (now: number) => {
      requestAnimationFrame(draw);
      if (paused || now - lastDraw < frameGap) return;
      lastDraw = now;

      const target = window.scrollY * SCROLL_RATE;
      eased += (target - eased) * EASE;

      const t = now * DRIFT + eased;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = ink;

      // Noise coordinates per grid step — smaller = larger landmasses.
      const step = 0.055;

      // Scrolling mostly pushes the field vertically, so it reads as moving
      // through terrain rather than sideways past it.
      const oy = eased * 1.6;

      for (let gy = 0; gy < rows; gy++) {
        for (let gx = 0; gx < cols; gx++) {
          const n = terrain(gx * step + t * 0.6, gy * step - t * 0.4 - oy, t);
          if (n <= SEA) continue;

          // Height above sea level, normalised: 0 at the coast, 1 at a peak.
          const e = Math.min(1, (n - SEA) / (PEAK - SEA));
          const ease = e * e * (3 - 2 * e);

          const i = gy * cols + gx;
          const x = gx * SPACING + jitter[i * 2];
          const y = gy * SPACING + jitter[i * 2 + 1];

          ctx.globalAlpha = ALPHA * (0.25 + 0.75 * ease);
          ctx.beginPath();
          ctx.arc(x, y, 0.45 + MAX_R * ease, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      ctx.globalAlpha = 1;
    };
    requestAnimationFrame(draw);

    // Don't burn cycles in a background tab.
    document.addEventListener('visibilitychange', () => {
      paused = document.hidden;
    });
  }
</script>
