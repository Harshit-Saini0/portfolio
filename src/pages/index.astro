---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, hero, socials, clients, overview } from '../site.config';

const published = (c: { data: { draft: boolean } }) => !c.data.draft;

const projects = await getCollection('projects', published);
const experience = await getCollection('experience', published);

const count = (n: number, one: string, many = `${one}s`) =>
  `${n} ${n === 1 ? one : many}`;

const cards = [
  { href: '/about/', title: 'About', blurb: overview.about, meta: null },
  {
    href: '/experience/',
    title: 'Experience',
    blurb: overview.experience,
    meta: count(experience.length, 'role'),
  },
  {
    href: '/projects/',
    title: 'Projects',
    blurb: overview.projects,
    meta: count(projects.length, 'project'),
  },
];

// Drives the scroll rail — ids must match the sections below.
const sections = [
  { id: 'top', label: 'Intro' },
  { id: 'index', label: 'Index' },
  ...(clients.length > 0 ? [{ id: 'worked-with', label: 'Worked with' }] : []),
  { id: 'contact', label: 'Contact' },
];
---

<Base sections={sections}>
  <section id="top" class="hero wrap">
    <h1 data-reveal>{hero.headline}</h1>
    <p class="intro" data-reveal>{hero.intro}</p>
    <div class="socials" data-reveal>
      {socials.map((s) => <a href={s.href} rel="me noopener">{s.label}</a>)}
    </div>
  </section>

  <section id="index" class="section wrap">
    <p class="section-label" data-reveal>Index</p>
    <div class="cards">
      {
        cards.map((s, i) => (
          <a class="card" href={s.href} data-reveal data-reveal-delay={i * 80}>
            <span class="card-head">
              <h2>{s.title}</h2>
              <span class="card-arrow">→</span>
            </span>
            <p>{s.blurb}</p>
            {s.meta && <span class="card-count">{s.meta}</span>}
          </a>
        ))
      }
    </div>
  </section>

  {
    clients.length > 0 && (
      <section id="worked-with" class="section wrap">
        <p class="section-label" data-reveal>Worked with</p>
        <div class="clients" data-reveal>
          {clients.map((c) => (
            <span>{c}</span>
          ))}
        </div>
      </section>
    )
  }

  <section id="contact" class="section wrap contact">
    <p class="section-label" data-reveal>Contact</p>
    <h2 data-reveal>Have something in mind? Let’s talk.</h2>
    <p data-reveal><a href={`mailto:${site.email}`}>{site.email}</a></p>
    <div class="socials" data-reveal>
      {socials.filter((s) => s.label !== 'Email').map((s) => <a href={s.href} rel="me noopener">{s.label}</a>)}
    </div>
  </section>
</Base>
