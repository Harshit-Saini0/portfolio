---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MediaPanel from '../../components/MediaPanel.astro';
import { overview } from '../../site.config';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Projects" description={overview.projects}>
  <section class="page-head wrap">
    <h1 data-reveal>Projects</h1>
    <p class="lede" data-reveal>{overview.projects}</p>
  </section>

  <section class="section wrap">
    {
      projects.length === 0 ? (
        <p class="empty">No projects published yet.</p>
      ) : (
        <div class="items">
          {projects.map((p, i) => (
            <article
              class:list={['item item-linked', { 'has-media': p.data.media.length > 0 }]}
              data-reveal
              data-reveal-delay={i * 70}
            >
              <a
                class="item-title"
                href={p.data.external ?? `/projects/${p.id}/`}
                rel={p.data.external ? 'noopener' : undefined}
              >
                <span class="item-title-text">{p.data.title}</span>
                <span class="item-arrow" aria-hidden="true">{p.data.external ? '↗' : '→'}</span>
              </a>
              <span class="item-meta">
                {p.data.kind} · {p.data.date.getFullYear()}
              </span>
              <div class="item-text">
                <span class="item-summary">{p.data.summary}</span>
              </div>
              <MediaPanel media={p.data.media} />
            </article>
          ))}
        </div>
      )
    }
  </section>
</Base>
